APP_NAME="Task Management"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://tasks.example.com
APP_TIMEZONE=Asia/Kathmandu
APP_SETUP_TOKEN=
INITIAL_COMPANY_NAME=
INITIAL_MANAGER_NAME=
INITIAL_MANAGER_EMAIL=
INITIAL_MANAGER_PASSWORD=
DEBUGBAR_ENABLED=false
ALLOW_DEMO_SEEDING=false
DEMO_SEED_PASSWORD=
TASK_REVIEW_SLA_DAYS=2

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=daily
LOG_DAILY_DAYS=14
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=warning

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=task_management
DB_USERNAME=task_management_app
DB_PASSWORD=replace-with-a-unique-database-password

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SESSION_SECURE_COOKIE=true
SESSION_HTTP_ONLY=true
SESSION_SAME_SITE=lax

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
LOCAL_FILESYSTEM_SERVE=false
QUEUE_CONNECTION=database
QUEUE_FAILED_DRIVER=database-uuids
DB_QUEUE_RETRY_AFTER=90
BACKUP_DISKS=s3
BACKUP_ARCHIVE_PASSWORD=
BACKUP_NOTIFICATION_EMAIL=operations@example.com

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USERNAME=replace-with-smtp-username
MAIL_PASSWORD=replace-with-smtp-password
MAIL_FROM_ADDRESS="tasks@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_ENDPOINT=
AWS_URL=
AWS_USE_PATH_STYLE_ENDPOINT=false

SENTRY_LARAVEL_DSN=
SENTRY_RELEASE=
SENTRY_ENVIRONMENT=production
SENTRY_SAMPLE_RATE=1.0
SENTRY_TRACES_SAMPLE_RATE=0.05

WEBPUSH_VAPID_SUBJECT=mailto:notifications@example.com
WEBPUSH_VAPID_PUBLIC_KEY=
WEBPUSH_VAPID_PRIVATE_KEY=
WEBPUSH_QUEUE=notifications
WEBPUSH_TTL=3600
WEBPUSH_STALE_AFTER_FAILURES=5

VITE_APP_NAME="${APP_NAME}"

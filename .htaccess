Options -Indexes

# Hostinger's PHP Git integration checks this Laravel repository out in
# public_html. Route every request into Laravel's public directory so files
# such as composer.json, app/, storage/, and .env are never served directly.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^(?!public(?:/|$))(.*)$ public/$1 [L]
</IfModule>

# Fail closed if rewrite support is unavailable.
<IfModule !mod_rewrite.c>
    <IfModule mod_authz_core.c>
        Require all denied
    </IfModule>
    <IfModule !mod_authz_core.c>
        Deny from all
    </IfModule>
</IfModule>
